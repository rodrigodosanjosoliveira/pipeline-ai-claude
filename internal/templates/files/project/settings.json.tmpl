{
  "permissions": {
    "deny": [
      "Edit(/.claude/**)",
      "Edit(/.mcp.json)",
      "Edit(/.pipeline-claude.json)",
      "Edit(/.pipeline-claude.lock)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/bin/pipeline-claude hook"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/bin/pipeline-claude fmt-hook"
          }
        ]
      }
    ]
  }
}
